{
  "name": "@lazyfounders/ingestion-core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free domain logic for the v2 news ingestion & publishing pipeline",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@lazyfounders/database": "*",
    "@mozilla/readability": "^0.6.0",
    "bullmq": "^5.0.0",
    "cheerio": "^1.2.0",
    "ioredis": "^5.4.0",
    "ipaddr.js": "^2.2.0",
    "jsdom": "^26.0.0",
    "sanitize-html": "^2.14.0",
    "saxes": "^6.0.0",
    "tinyld": "^1.3.4",
    "undici": "^7.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0",
    "@lazyfounders/llm": "*",
    "@aws-sdk/client-s3": "^3.1106.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.0.0",
    "@types/sanitize-html": "^2.13.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editorial": {
      "types": "./dist/editorial/public.d.ts",
      "default": "./dist/editorial/public.js"
    },
    "./package.json": "./package.json"
  }
}
