/// Single source of truth for the LazyFounders database.
/// `prisma generate` emits two clients: the default one for the Node services
/// and a copy inside the Next.js dashboard (its standalone build bundles it).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

generator dashboard {
  provider        = "prisma-client-js"
  output          = "../../../apps/api-dashboard/src/generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

/// Registered news website sources for crawling
model Source {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  domain            String    @unique
  baseUrl           String    @map("base_url")
  crawlFrequency    String    @map("crawl_frequency") @default("0 */1 * * *")
  enabled           Boolean   @default(true)
  priority          Int       @default(5) @db.SmallInt
  category          String?
  customSitemapUrls String[]  @map("custom_sitemap_urls")
  proxyEnabled      Boolean   @default(false) @map("proxy_enabled")
  customHeaders     Json?     @map("custom_headers")
  crawlPolicy       Json?     @map("crawl_policy")
  customFilterRules Json?     @map("custom_filter_rules")
  recencyWindowHours Int      @default(72) @map("recency_window_hours") @db.SmallInt
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lastCrawledAt     DateTime? @map("last_crawled_at")

  // --- Trusted Source Registry (v2) ---
  /// Stable registry key from sources/<country>/<key>.yaml
  registryKey          String?   @unique @map("registry_key")
  country              String?   /// ISO-3166 alpha-2, e.g. IN, JP
  defaultLanguage      String?   @map("default_language") /// BCP-47, e.g. en, ja
  trustStatus          String    @default("PENDING") @map("trust_status") /// PENDING | APPROVED | SUSPENDED
  feedUrls             String[]  @map("feed_urls")
  discoveryMethods     String[]  @map("discovery_methods") /// sitemap | news_sitemap | rss | atom
  crawlIntervalMinutes Int       @default(60) @map("crawl_interval_minutes")
  maxArticlesPerScan   Int       @default(50) @map("max_articles_per_scan")
  rateLimitPerMinute   Int       @default(30) @map("rate_limit_per_minute")
  renderPolicy         String    @default("never") @map("render_policy") /// never | fallback | required
  robotsRequired       Boolean   @default(true) @map("robots_required")
  adapterKey           String?   @map("adapter_key")
  translationPolicy    Json?     @map("translation_policy")
  publishingPolicy     Json?     @map("publishing_policy")
  imagePolicy          String    @default("link_with_credit") @map("image_policy") /// none | link_with_credit | rehost
  lastSuccessfulScanAt DateTime? @map("last_successful_scan_at")
  lastChangeDetectedAt DateTime? @map("last_change_detected_at")
  consecutiveFailures  Int       @default(0) @map("consecutive_failures")
  failureStatus        String    @default("OK") @map("failure_status") /// OK | DEGRADED | FAILING | BLOCKED
  lastError            String?   @map("last_error")
  configHash           String?   @map("config_hash")

  sitemaps          Sitemap[]
  urlStates         UrlState[]
  crawlRuns         CrawlRun[]
  domains           SourceDomain[]
  sourceArticles    SourceArticle[]

  @@index([enabled, priority])
  @@map("sources")
}

/// Discovered sitemap URLs per source
model Sitemap {
  id              String    @id @default(uuid()) @db.Uuid
  sourceId        String    @map("source_id") @db.Uuid
  url             String
  type            String    /// urlset | sitemapindex | rss | atom
  discoveryMethod String    @map("discovery_method") /// robots_txt | endpoint_probe | cms_detection | rss_feed | atom_feed | heuristic | manual
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  source          Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  states          SitemapState[]

  @@unique([sourceId, url])
  @@map("sitemaps")
}

/// Per-sitemap fetch state tracking
model SitemapState {
  id              String    @id @default(uuid()) @db.Uuid
  sitemapId       String    @map("sitemap_id") @db.Uuid
  etag            String?
  lastModified    String?   @map("last_modified")
  contentHash     String?   @map("content_hash")
  urlCount        Int       @default(0) @map("url_count")
  lastFetchedAt   DateTime  @map("last_fetched_at")
  fetchDurationMs Int?      @map("fetch_duration_ms")
  httpStatus      Int?      @map("http_status") @db.SmallInt
  snapshotHash    String?   @map("snapshot_hash")
  changed         Boolean   @default(true)
  notModified     Boolean   @default(false) @map("not_modified")
  createdAt       DateTime  @default(now()) @map("created_at")

  sitemap         Sitemap   @relation(fields: [sitemapId], references: [id], onDelete: Cascade)

  @@index([sitemapId, lastFetchedAt(sort: Desc)])
  @@map("sitemap_states")
}

/// Per-URL state for the diff engine
model UrlState {
  id                  String    @id @default(uuid()) @db.Uuid
  sourceId            String    @map("source_id") @db.Uuid
  url                 String
  urlHash             String    @unique @map("url_hash")
  normalizedSlug      String?   @map("normalized_slug")
  lastmod             DateTime?
  etag                String?
  contentHash         String?   @map("content_hash")
  status              String    @default("new") /// new | active | removed | renamed
  changeType          String?   @map("change_type") /// NEW | UPDATED | REMOVED | RENAMED
  titleHint           String?   @map("title_hint")
  newsPublicationDate DateTime? @map("news_publication_date")
  priority            Float?    @db.Real
  changeFreq          String?   @map("change_freq")
  firstSeenAt         DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt          DateTime  @default(now()) @map("last_seen_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  /// sha256 of the canonicalised URL (v2 identity; urlHash is legacy base64)
  urlFingerprint      String?   @unique @map("url_fingerprint")
  canonicalUrl        String?   @map("canonical_url")
  /// Version marker (lastmod or first-seen) of the last scrape job enqueued
  lastEnqueuedVersion String?   @map("last_enqueued_version")

  source              Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  slugHistory         SlugHistory[]
  categorizationResult CategorizationResult?
  sourceArticles      SourceArticle[]

  @@index([sourceId, status])
  @@index([normalizedSlug])
  @@index([lastSeenAt])
  @@map("url_states")
}

/// Slug change history for rename detection
model SlugHistory {
  id              String    @id @default(uuid()) @db.Uuid
  urlStateId      String    @map("url_state_id") @db.Uuid
  slug            String
  normalizedSlug  String    @map("normalized_slug")
  url             String
  detectedAt      DateTime  @default(now()) @map("detected_at")

  urlState        UrlState  @relation(fields: [urlStateId], references: [id], onDelete: Cascade)

  @@index([normalizedSlug])
  @@index([urlStateId])
  @@map("slug_histories")
}

/// Crawl run execution logs
model CrawlRun {
  id                String    @id @default(uuid()) @db.Uuid
  sourceId          String    @map("source_id") @db.Uuid
  traceId           String    @map("trace_id")
  status            String    @default("running") /// running | completed | unchanged | failed | partial | skipped_locked
  totalUrls         Int       @default(0) @map("total_urls")
  newUrls           Int       @default(0) @map("new_urls")
  updatedUrls       Int       @default(0) @map("updated_urls")
  removedUrls       Int       @default(0) @map("removed_urls")
  renamedUrls       Int       @default(0) @map("renamed_urls")
  unchangedUrls     Int       @default(0) @map("unchanged_urls")
  errorCount        Int       @default(0) @map("error_count")
  sitemapsProcessed Int       @default(0) @map("sitemaps_processed")
  durationMs        Int?      @map("duration_ms")
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")

  source            Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  errors            CrawlError[]

  @@index([sourceId, startedAt(sort: Desc)])
  @@index([traceId])
  @@map("crawl_runs")
}

/// Per-URL or per-sitemap error records
model CrawlError {
  id              String    @id @default(uuid()) @db.Uuid
  crawlRunId      String    @map("crawl_run_id") @db.Uuid
  url             String?
  errorType       String    @map("error_type") /// fetch_error | parse_error | timeout | bot_block | rate_limit | unknown
  errorMessage    String    @map("error_message")
  httpStatus      Int?      @map("http_status") @db.SmallInt
  strategy        String?
  retryCount      Int       @default(0) @map("retry_count") @db.SmallInt
  metadata        Json?
  occurredAt      DateTime  @default(now()) @map("occurred_at")

  crawlRun        CrawlRun  @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)

  @@index([crawlRunId])
  @@index([errorType])
  @@map("crawl_errors")
}

/// Content extraction results from scraper
model ScrapeResult {
  id                String    @id @default(uuid()) @db.Uuid
  categorizationId  String    @unique @map("categorization_id") @db.Uuid
  traceId           String    @map("trace_id")
  title             String?
  subtitle          String?
  bodyText          String?   @map("body_text")
  bodyHtml          String?   @map("body_html")
  author            String?
  publishedDate     DateTime? @map("published_date")
  language          String?
  wordCount         Int?      @map("word_count")
  readingTimeMin    Float?    @map("reading_time_min") @db.Real
  images            Json?
  metaTags          Json?     @map("meta_tags")
  openGraph         Json?     @map("open_graph")
  twitterCard       Json?     @map("twitter_card")
  canonicalUrl      String?   @map("canonical_url")
  jsonLd            Json?     @map("json_ld")
  articleSchema     Json?     @map("article_schema")
  breadcrumbs       Json?
  contentHash       String?   @map("content_hash")
  extractionMethod  String?   @map("extraction_method")
  fetchStrategy     String?   @map("fetch_strategy")
  durationMs        Int?      @map("duration_ms")
  status            String    @default("success") /// success | partial | failed
  errorMessage      String?   @map("error_message")
  rawHtmlSize       Int?      @map("raw_html_size")
  scrapedAt         DateTime  @default(now()) @map("scraped_at")

  categorization    CategorizationResult @relation(fields: [categorizationId], references: [id], onDelete: Cascade)

  @@index([traceId])
  @@index([scrapedAt(sort: Desc)])
  @@map("scrape_results")
}

/// AI-generated categorization and metadata
model CategorizationResult {
  id                String    @id @default(uuid()) @db.Uuid
  urlStateId        String    @unique @map("url_state_id") @db.Uuid
  primaryCategory   String?   @map("primary_category")
  tags              Json?
  summary           String?
  entities          Json?
  sentiment         String?
  confidenceScore   Float?    @map("confidence_score") @db.Real
  embedding         Unsupported("vector(1024)")?
  categorizedAt     DateTime  @default(now()) @map("categorized_at")

  urlState          UrlState @relation(fields: [urlStateId], references: [id], onDelete: Cascade)
  scrapeResult      ScrapeResult?
  intelligenceResult IntelligenceResult?

  @@index([primaryCategory])
  @@map("categorization_results")
}

/// Results of the Intelligence Engine deduplication
model IntelligenceResult {
  id                  String    @id @default(uuid()) @db.Uuid
  categorizationId    String    @unique @map("categorization_id") @db.Uuid
  isDuplicate         Boolean   @default(false) @map("is_duplicate")
  duplicateOfId       String?   @map("duplicate_of_id") @db.Uuid
  deduplicatedAt      DateTime  @default(now()) @map("deduplicated_at")
  
  categorization      CategorizationResult @relation(fields: [categorizationId], references: [id], onDelete: Cascade)
  originalContent     OriginalContent?

  @@index([isDuplicate])
  @@map("intelligence_results")
}

/// The final LLM-rewritten, SEO-optimized original article
model OriginalContent {
  id                    String    @id @default(uuid()) @db.Uuid
  intelligenceResultId  String    @unique @map("intelligence_result_id") @db.Uuid
  seoTitle              String    @map("seo_title")
  slug                  String    @unique
  bodyHtml              String    @map("body_html")
  metaDescription       String    @map("meta_description")
  keywords              String[]
  companies             String[]
  headerImage           String?   @map("header_image")
  publishedToBlogAt     DateTime? @map("published_to_blog_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  intelligenceResult    IntelligenceResult @relation(fields: [intelligenceResultId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@map("original_contents")
}

/// Public API Keys for Developer Access
model ApiKey {
  id            String    @id @default(uuid()) @db.Uuid
  key           String    @unique
  name          String    @default("Default Key")
  requestsCount Int       @default(0) @map("requests_count")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastUsedAt    DateTime? @map("last_used_at")

  @@map("api_keys")
}

// =====================================================================
// v2 ingestion & publishing pipeline
// =====================================================================

/// Approved-domain allowlist per source. Only hosts listed here may be fetched
/// (SSRF guard) or enter the publishing pipeline.
model SourceDomain {
  id        String   @id @default(uuid()) @db.Uuid
  sourceId  String   @map("source_id") @db.Uuid
  domain    String   @unique
  kind      String   @default("primary") /// primary | alias | asset
  createdAt DateTime @default(now()) @map("created_at")

  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@map("source_domains")
}

/// Maps any observed URL (redirect hop, AMP, tracking variant) to one canonical identity.
model UrlAlias {
  id                   String   @id @default(uuid()) @db.Uuid
  fingerprint          String   @unique
  canonicalFingerprint String   @map("canonical_fingerprint")
  url                  String
  kind                 String   /// original | redirect | canonical | amp
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([canonicalFingerprint])
  @@map("url_aliases")
}

/// Durable record for every stage job. BullMQ is only the transport; this table is the truth.
model PipelineJob {
  id             String    @id @default(uuid()) @db.Uuid
  idempotencyKey String    @unique @map("idempotency_key")
  stage          String
  correlationId  String    @map("correlation_id")
  subjectType    String    @map("subject_type")
  subjectId      String    @map("subject_id")
  payload        Json
  status         String    @default("QUEUED") /// QUEUED | RUNNING | SUCCEEDED | RETRY_PENDING | DEAD_LETTER | CANCELLED
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  timeoutMs      Int       @default(120000) @map("timeout_ms")
  nextRunAt      DateTime? @map("next_run_at")
  lastError      Json?     @map("last_error")
  replayCount    Int       @default(0) @map("replay_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, stage])
  @@index([correlationId])
  @@index([subjectType, subjectId])
  @@map("pipeline_jobs")
}

/// Transactional outbox: written in the same transaction as the state change that
/// produced it, then dispatched to BullMQ by the outbox dispatcher.
model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  stage          String
  idempotencyKey String    @unique @map("idempotency_key")
  correlationId  String    @map("correlation_id")
  subjectType    String    @map("subject_type")
  subjectId      String    @map("subject_id")
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at")
  dispatchedAt   DateTime? @map("dispatched_at")
  attempts       Int       @default(0)

  @@index([dispatchedAt, createdAt])
  @@map("outbox_events")
}

/// Immutable raw fetch snapshot (content stored in S3 or the local snapshot dir).
model RawSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  sha256      String   @unique
  storageKey  String   @map("storage_key")
  contentType String?  @map("content_type")
  bytes       Int
  url         String
  httpStatus  Int?     @map("http_status") @db.SmallInt
  fetchedAt   DateTime @default(now()) @map("fetched_at")

  sourceArticles SourceArticle[]

  @@map("raw_snapshots")
}

/// One fetched + normalised version of a publisher article.
model SourceArticle {
  id                   String    @id @default(uuid()) @db.Uuid
  sourceId             String    @map("source_id") @db.Uuid
  urlStateId           String?   @map("url_state_id") @db.Uuid
  snapshotId           String?   @map("snapshot_id") @db.Uuid
  correlationId        String    @map("correlation_id")
  /// Idempotency key of the scrape job that created this row (replays reuse the row)
  scrapeKey            String?   @unique @map("scrape_key")
  state                String    @default("DISCOVERED") /// DISCOVERED | SCRAPED | NORMALIZED | STRUCTURED | DEDUPED | NEEDS_REVIEW | REJECTED | DEAD_LETTER | ARCHIVED
  stateReason          String?   @map("state_reason")
  originalUrl          String    @map("original_url")
  finalUrl             String?   @map("final_url")
  canonicalUrl         String?   @map("canonical_url")
  canonicalFingerprint String    @map("canonical_fingerprint")
  publisher            String
  country              String?
  language             String?
  languageConfidence   Float?    @map("language_confidence") @db.Real
  headline             String?
  subheadline          String?
  author               String?
  publishedAt          DateTime? @map("published_at")
  modifiedAt           DateTime? @map("modified_at")
  bodyText             String?   @map("body_text")
  sanitizedHtml        String?   @map("sanitized_html")
  leadImage            String?   @map("lead_image")
  imageCredit          String?   @map("image_credit")
  categories           String[]
  tags                 String[]
  structuredMeta       Json?     @map("structured_meta")
  outboundLinks        Json?     @map("outbound_links")
  extractionMethod     String?   @map("extraction_method")
  contentHash          String?   @map("content_hash")
  paywalled            Boolean   @default(false)
  fetchedAt            DateTime  @default(now()) @map("fetched_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  source         Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  urlState       UrlState?        @relation(fields: [urlStateId], references: [id], onDelete: SetNull)
  snapshot       RawSnapshot?     @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  translations   Translation[]
  extractions    FactExtraction[]
  storySource    StorySource?
  citations      ArticleCitation[]

  @@unique([canonicalFingerprint, contentHash])
  @@index([contentHash])
  @@index([state])
  @@index([publishedAt(sort: Desc)])
  @@map("source_articles")
}

model Translation {
  id              String   @id @default(uuid()) @db.Uuid
  sourceArticleId String   @map("source_article_id") @db.Uuid
  sourceLanguage  String   @map("source_language")
  targetLanguage  String   @map("target_language")
  model           String
  modelVersion    String?  @map("model_version")
  promptVersion   String   @map("prompt_version")
  headline        String?
  summary         String?
  body            String?
  protectedTokens Json?    @map("protected_tokens")
  validation      Json?
  status          String   @default("VALID") /// VALID | NEEDS_REVIEW
  createdAt       DateTime @default(now()) @map("created_at")

  sourceArticle   SourceArticle @relation(fields: [sourceArticleId], references: [id], onDelete: Cascade)

  @@unique([sourceArticleId, targetLanguage, promptVersion])
  @@map("translations")
}

model FactExtraction {
  id                String   @id @default(uuid()) @db.Uuid
  sourceArticleId   String   @map("source_article_id") @db.Uuid
  model             String
  promptVersion     String   @map("prompt_version")
  schemaVersion     String   @map("schema_version")
  payload           Json?
  overallConfidence Float?   @map("overall_confidence") @db.Real
  validationStatus  String   @map("validation_status") /// VALID | INVALID | NEEDS_REVIEW
  errors            Json?
  attempts          Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")

  sourceArticle     SourceArticle @relation(fields: [sourceArticleId], references: [id], onDelete: Cascade)

  @@unique([sourceArticleId, promptVersion, schemaVersion])
  @@map("fact_extractions")
}

/// One real-world event. Several SourceArticles from different publishers may support it.
model Story {
  id            String    @id @default(uuid()) @db.Uuid
  storyType     String    @map("story_type")
  eventKey      String?   @map("event_key")
  primaryEntity String?   @map("primary_entity")
  eventDate     DateTime? @map("event_date")
  headline      String
  facts         Json?
  embedding     Unsupported("vector(1024)")?
  status        String    @default("ACTIVE") /// ACTIVE | NEEDS_REVIEW | MERGED | ARCHIVED
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sources       StorySource[]
  claims        StoryClaim[]
  article       Article?

  @@index([eventKey])
  @@index([createdAt(sort: Desc)])
  @@map("stories")
}

model StorySource {
  id               String   @id @default(uuid()) @db.Uuid
  storyId          String   @map("story_id") @db.Uuid
  sourceArticleId  String   @unique @map("source_article_id") @db.Uuid
  role             String   @default("SUPPORTING") /// PRIMARY | SUPPORTING
  decision         String   /// UNIQUE | SAME_STORY | POSSIBLE_DUPLICATE
  similarity       Float?   @db.Real
  reasons          Json?
  contributedFacts Boolean  @default(false) @map("contributed_facts")
  createdAt        DateTime @default(now()) @map("created_at")

  story            Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  sourceArticle    SourceArticle @relation(fields: [sourceArticleId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@map("story_sources")
}

model StoryClaim {
  id               String   @id @default(uuid()) @db.Uuid
  storyId          String   @map("story_id") @db.Uuid
  text             String
  kind             String   @default("fact") /// fact | quote
  claimKey         String   @map("claim_key")
  sourceArticleIds String[] @map("source_article_ids")
  evidence         Json?
  confidence       Float?   @db.Real
  translated       Boolean  @default(false)
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")

  story            Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, claimKey])
  @@map("story_claims")
}

/// The LazyFounders article for a story. Content lives in immutable ArticleVersions.
model Article {
  id                 String    @id @default(uuid()) @db.Uuid
  storyId            String?   @unique @map("story_id") @db.Uuid
  slug               String    @unique
  status             String    @default("GENERATED") /// GENERATED | VALIDATED | DRAFT | NEEDS_REVIEW | APPROVED | PUBLISHED | REJECTED | ARCHIVED
  currentVersionId   String?   @map("current_version_id") @db.Uuid
  publishedVersionId String?   @map("published_version_id") @db.Uuid
  category           String?
  tags               String[]
  companies          String[]
  legacyContentId    String?   @unique @map("legacy_content_id") @db.Uuid
  publishedAt        DateTime? @map("published_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  story              Story?            @relation(fields: [storyId], references: [id], onDelete: SetNull)
  versions           ArticleVersion[]
  actions            EditorialAction[]

  @@index([status])
  @@index([publishedAt(sort: Desc)])
  @@index([category])
  @@map("articles")
}

model ArticleVersion {
  id               String   @id @default(uuid()) @db.Uuid
  articleId        String   @map("article_id") @db.Uuid
  version          Int
  contentHash      String   @map("content_hash")
  headline         String
  seoTitle         String   @map("seo_title")
  metaDescription  String   @map("meta_description")
  intro            String
  bodyMarkdown     String   @map("body_markdown")
  keyTakeaways     Json     @map("key_takeaways")
  whatThisMeans    String?  @map("what_this_means")
  faq              Json?
  socialSummary    String?  @map("social_summary")
  internalLinks    Json?    @map("internal_links")
  featuredImage    Json?    @map("featured_image")
  generator        Json
  validationReport Json?    @map("validation_report")
  createdBy        String   @default("pipeline") @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  article          Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  citations        ArticleCitation[]

  @@unique([articleId, version])
  @@unique([articleId, contentHash])
  @@map("article_versions")
}

model ArticleCitation {
  id              String    @id @default(uuid()) @db.Uuid
  versionId       String    @map("version_id") @db.Uuid
  sourceArticleId String?   @map("source_article_id") @db.Uuid
  position        Int
  publisher       String
  url             String
  title           String?
  language        String?
  publishedAt     DateTime? @map("published_at")

  version         ArticleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sourceArticle   SourceArticle? @relation(fields: [sourceArticleId], references: [id], onDelete: SetNull)

  @@unique([versionId, position])
  @@map("article_citations")
}

/// Append-only editorial audit trail.
model EditorialAction {
  id         String   @id @default(uuid()) @db.Uuid
  articleId  String   @map("article_id") @db.Uuid
  versionId  String?  @map("version_id") @db.Uuid
  actor      String
  action     String   /// generate | validate | approve | reject | publish | archive | edit | republish_noop
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@map("editorial_actions")
}
