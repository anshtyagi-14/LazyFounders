{
  "name": "@lazyfounders/discovery-service",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1091.0",
    "@fastify/cors": "^10.0.0",
    "@lazyfounders/config": "*",
    "@lazyfounders/logger": "*",
    "@lazyfounders/shared": "*",
    "@prisma/client": "^6.0.0",
    "axios": "^1.7.0",
    "bullmq": "^5.0.0",
    "cheerio": "^1.2.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "pino": "^9.0.0",
    "playwright-extra": "^4.3.6",
    "prom-client": "^15.1.3",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sax": "^1.4.0",
    "saxes": "^6.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/sax": "^1.2.0",
    "@types/uuid": "^10.0.0",
    "jest": "^30.4.2",
    "prisma": "^6.0.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
