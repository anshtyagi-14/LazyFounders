# Application
NODE_ENV=development
LOG_LEVEL=debug
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://lazyfounders:lazyfounders@localhost:5432/lazyfounders?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# BullMQ
BULLMQ_PREFIX=lf

# Queue Mode (bullmq | sqs)
QUEUE_ADAPTER=bullmq

# AWS SQS (production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_DISCOVERY_QUEUE_URL=
SQS_SCRAPER_QUEUE_URL=

# Fetcher
FETCH_TIMEOUT_MS=30000
FETCH_MAX_RETRIES=3
FETCH_RETRY_DELAY_MS=1000
DEFAULT_RATE_LIMIT_RPM=30
MAX_CONCURRENT_FETCHES_PER_DOMAIN=5

# Proxy (BrightData)
PROXY_ENABLED=false
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_PROVIDER=brightdata

# Playwright
PLAYWRIGHT_HEADLESS=true
BROWSER_POOL_SIZE=5
BROWSER_RECYCLE_AFTER=50

# Discovery
DEFAULT_RECENCY_WINDOW_HOURS=72
BLOOM_FILTER_EXPECTED_ITEMS=500000
BLOOM_FILTER_FALSE_POSITIVE_RATE=0.001

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
