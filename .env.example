# ---------------------------------------------------------------------------
# LazyFounders - environment template. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://lazyfounders:lazyfounders@localhost:5433/lazyfounders?schema=public
REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=
BULLMQ_PREFIX=lf

# --- Service URLs (dashboard -> services) ---
DISCOVERY_SERVICE_URL=http://localhost:3001
SCRAPER_SERVICE_URL=http://localhost:3002
CATEGORIZATION_SERVICE_URL=http://localhost:3003
INTELLIGENCE_SERVICE_URL=http://localhost:3004

# --- Security ---
# Shared secret for service-to-service admin/stateless APIs (required in production).
INTERNAL_API_TOKEN=change-me-long-random-string
# Editorial accounts: user:scrypt$salt$hash:role (role = editor|admin). Generate entries with:
#   npm run auth:hash -- '<password>' <user> <editor|admin>
EDITOR_USERS=
# Legacy single admin account (still supported; prefer EDITOR_USERS). No defaults exist.
ADMIN_USER=
ADMIN_PASSWORD=
# Secret the publishing service uses to call the dashboard revalidation endpoint.
REVALIDATE_SECRET=change-me-too
REVALIDATE_URL=http://localhost:3000/api/revalidate

# --- Pipelines ---
# v2 = trusted-source ingestion & publishing pipeline. Legacy = URL-categorisation pipeline.
PIPELINE_V2_ENABLED=false
LEGACY_PIPELINE_ENABLED=true
# Run the discovery scheduler (only processes that pass scheduler:true, i.e. discovery-service).
PIPELINE_SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=60000
# Stages a process runs (comma separated or "all"). Defaults per service:
#   discovery: discover.source | scraper: article.scrape,article.normalize
#   categorization: article.extract,article.translate | intelligence: story.dedupe,article.generate,article.validate
#   publishing: article.publish
# WORKER_STAGES=
# Per-stage tuning (examples): WORKER_CONCURRENCY_ARTICLE_SCRAPE=8, JOB_MAX_ATTEMPTS_ARTICLE_GENERATE=4,
#   JOB_TIMEOUT_MS_ARTICLE_EXTRACT=300000
JOB_BACKOFF_BASE_MS=5000
JOB_BACKOFF_MAX_MS=1800000
OUTBOX_POLL_MS=1000

# --- Publishing ---
PUBLISH_LANGUAGE=en
SITE_BRAND_NAME=Lazyfounder
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Auto-publish stays off unless enabled here AND in a source's publishing policy AND all gates pass.
AUTO_PUBLISH_ENABLED=false

# --- LLM (Claude on Amazon Bedrock; default AWS credential chain) ---
AWS_REGION=ap-south-1
BEDROCK_REGION=ap-south-1
# Per-task model ids (defaults to anthropic.claude-opus-5):
# LLM_MODEL_DEFAULT=anthropic.claude-opus-5
# LLM_MODEL_EXTRACT=
# LLM_MODEL_TRANSLATE=
# LLM_MODEL_GENERATE=
# LLM_EFFORT_EXTRACT=medium
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
LLM_TIMEOUT_MS=600000
# Daily token budget across all replicas (0 = unlimited). When reached, LLM work is deferred to the next UTC day.
LLM_DAILY_TOKEN_BUDGET=0

# --- Fetching ---
CRAWLER_USER_AGENT=LazyFoundersBot/1.0 (+https://lazyfounders.com/bot)
FETCH_TIMEOUT_MS=20000
FETCH_MAX_BYTES_HTML=5242880
FETCH_MAX_BYTES_SITEMAP=20971520
MIN_ARTICLE_CHARS=300
MIN_ARTICLE_CHARS_CJK=120

# --- Raw snapshots (immutable) ---
SNAPSHOT_STORAGE=fs
SNAPSHOT_DIR=./data/snapshots
# SNAPSHOT_STORAGE=s3
# SNAPSHOT_BUCKET=lazyfounders-raw-snapshots

# --- Dedup ---
DEDUP_WINDOW_DAYS=7
DEDUP_SAME_STORY_COS=0.9
DEDUP_REVIEW_COS=0.8

# --- Alerts ---
# Slack-compatible incoming webhook for dead letters / failing sources.
ALERT_WEBHOOK_URL=
ALERT_DLQ_THRESHOLD=25
ALERT_SOURCE_FAILURES=3

# --- Legacy pipeline (unchanged) ---
S3_BUCKET_NAME=lazyfounders-media
