lid rgba(29,184,122,.18);overflow:hidden;position:relative;box-shadow:0 24px 80px rgba(0,0,0,.5),0 8px 24px rgba(0,0,0,.3),0 0 0 1px rgba(29,184,122,.08);animation:blogypop-pop .3s cubic-bezier(.34,1.56,.64,1)}@keyframes blogypop-pop{0%{transform:scale(.9) translateY(10px);opacity:0}to{transform:scale(1) translateY(0);opacity:1}}.blogy-popup .top-bar{height:3px;background:linear-gradient(90deg,#0a5535,#1db87a,#25d48a,#1db87a,#0a5535);background-size:300% 100%;animation:blogypop-shimmer 2.5s linear infinite}@keyframes blogypop-shimmer{0%{background-position:0}to{background-position:300%}}.blogy-popup .close{position:absolute;top:14px;right:16px;z-index:20;width:26px;height:26px;border-radius:50%;background:hsla(0,0%,100%,.07);border:1px solid hsla(0,0%,100%,.09);color:hsla(0,0%,100%,.35);font-size:10px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .18s}.blogy-popup .close:hover{background:hsla(0,0%,100%,.12);color:hsla(0,0%,100%,.6)}.blogy-popup .visual{padding:32px 28px 20px;display:flex;flex-direction:column;align-items:center;gap:14px;position:relative}.blogy-popup .visual:before{content:"";position:absolute;top:0;left:50%;transform:translateX(-50%);width:260px;height:160px;pointer-events:none;background:radial-gradient(ellipse at 50% 0,rgba(29,184,122,.1),transparent 70%)}.blogy-popup .counter-wrap{text-align:center}.blogy-popup .counter-num{font-family:Space Grotesk,sans-serif;font-size:64px;font-weight:800;color:#fff;line-height:1;letter-spacing:-.03em}.blogy-popup .counter-label{font-size:11px;color:hsla(0,0%,100%,.35);letter-spacing:.08em;text-transform:uppercase;margin-top:5px}.blogy-popup .bars{display:flex;align-items:flex-end;gap:3px;height:28px}.blogy-popup .bar{width:8px;border-radius:2px 2px 0 0;background:rgba(29,184,122,.15);transition:height .7s cubic-bezier(.4,0,.2,1),background .4s}.blogy-popup .live-pill{display:flex;align-items:center;gap:6px;background:rgba(29,184,122,.08);border:1px solid rgba(29,184,122,.15);border-radius:20px;padding:6px 12px;font-size:10.5px;color:hsla(0,0%,100%,.5);max-width:100%;overflow:hidden}.blogy-popup .live-dot{width:5px;height:5px;border-radius:50%;background:#1db87a;flex-shrink:0;animation:blogypop-lp 1.2s ease-in-out infinite}@keyframes blogypop-lp{0%,to{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.5)}}.blogy-popup .live-pill span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.blogy-popup .live-pill strong{color:#1db87a;font-weight:700}.blogy-popup .copy{padding:4px 28px 28px;display:flex;flex-direction:column;gap:12px}.blogy-popup .headline{font-family:Space Grotesk,sans-serif;font-size:26px;font-weight:800;color:#fff;line-height:1.15;letter-spacing:-.02em}.blogy-popup .headline em{color:#1db87a;font-style:normal}.blogy-popup .connect-line{font-size:12px;color:hsla(0,0%,100%,.38);line-height:1.6;border-left:2px solid rgba(29,184,122,.3);padding-left:12px}.blogy-popup .connect-line strong{color:hsla(0,0%,100%,.65);font-weight:600}.blogy-popup .cta{width:100%;padding:15px;border-radius:12px;background:#1db87a;color:#fff;border:none;text-decoration:none;text-align:center;display:block;font-family:Inter,sans-serif;font-size:15px;font-weight:800;cursor:pointer;letter-spacing:.01em;box-shadow:0 4px 20px rgba(29,184,122,.4);transition:all .18s;position:relative;overflow:hidden;animation:blogypop-glow 3s ease-in-out infinite}@keyframes blogypop-glow{0%,to{box-shadow:0 4px 20px rgba(29,184,122,.4)}50%{box-shadow:0 4px 32px rgba(29,184,122,.6),0 0 0 5px rgba(29,184,122,.07)}}.blogy-popup .cta:after{content:"";position:absolute;top:0;left:-100%;width:50%;height:100%;background:linear-gradient(90deg,transparent,hsla(0,0%,100%,.15),transparent);animation:blogypop-shine 2.8s ease-in-out infinite}@keyframes blogypop-shine{0%,60%{left:-100%}75%{left:120%}to{left:120%}}.blogy-popup .cta:hover{background:#22d48a;transform:scale(.985)}.blogy-popup .bottom{display:flex;flex-direction:column;align-items:center;gap:7px}.blogy-popup .trust{display:flex;align-items:center;gap:10px}.blogy-popup .ti{font-size:9.5px;color:hsla(0,0%,100%,.22);display:flex;align-items:center;gap:3px}.blogy-popup .ti:before{content:"✓";color:#1db87a;font-size:9px;font-weight:700}.blogy-popup .neg{font-size:10px;color:hsla(0,0%,100%,.18);cursor:pointer;text-decoration:underline;text-underline-offset:3px;transition:color .18s}.blogy-popup .neg:hover{color:hsla(0,0%,100%,.35)}.blogy-toast{position:fixed;left:50%;bottom:32px;transform:translateX(-50%);z-index:10000;background:#0a2e22;border:1px solid rgba(29,184,122,.4);color:#fff;font-family:Inter,sans-serif;font-size:13px;font-weight:600;padding:11px 18px;border-radius:12px;display:flex;align-items:center;gap:8px;box-shadow:0 12px 40px rgba(0,0,0,.4);animation:blogypop-toast .3s ease}.blogy-toast:before{content:"✓";color:#1db87a;font-weight:800}@keyframes blogypop-toast{0%{opacity:0;transform:translateX(-50%) translateY(10px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}