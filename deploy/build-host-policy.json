{
  "Comment": "Smallest grant that lets deploy/ec2-build.sh run. Attach to the user that launches the build host. Instance types are arm64 because the ECS cluster runs on Graviton. Everything else the build needs (ECR push, ECS rollout) the github-action user already has.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FindPlacement",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceAttribute",
        "ec2:GetConsoleOutput"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LaunchBuildHost",
      "Effect": "Allow",
      "Action": ["ec2:RunInstances", "ec2:CreateTags"],
      "Resource": "*",
      "Condition": {
        "StringEqualsIfExists": {
          "ec2:InstanceType": ["c7g.xlarge", "c7g.2xlarge", "c7g.4xlarge", "c6g.2xlarge"]
        }
      }
    },
    {
      "Sid": "CleanUpBuildHostOnly",
      "Effect": "Allow",
      "Action": ["ec2:TerminateInstances", "ec2:StopInstances"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Purpose": "image-build"
        }
      }
    }
  ]
}
