# Production environment for the ECS task definitions.
#
# Copy to deploy/.env.production (gitignored), fill in the secrets, then:
#   node deploy/update-task-defs.mjs --dry-run
#
# Anything already set on a task definition is preserved unless listed here.
# Set a key to an empty value to delete it from the task definition.
#
# NOTE: these land in ECS task definitions in PLAINTEXT. Anyone with
# ecs:DescribeTaskDefinition can read them. Moving them to Secrets Manager and
# referencing them via the task definition `secrets` block is the safer option.

NODE_ENV=production
LOG_LEVEL=info

# --- Queue ---
BULLMQ_PREFIX=lf
QUEUE_ADAPTER=bullmq

# --- Pipelines ---
PIPELINE_V2_ENABLED=true
LEGACY_PIPELINE_ENABLED=true
SCHEDULER_TICK_MS=60000
JOB_BACKOFF_BASE_MS=5000
JOB_BACKOFF_MAX_MS=1800000
OUTBOX_POLL_MS=1000

# --- Publishing ---
PUBLISH_LANGUAGE=en
SITE_BRAND_NAME=LazyFounders
# Must include the scheme, or sitemap/feed/OG URLs come out malformed.
NEXT_PUBLIC_SITE_URL=https://lazyfounder.in
REVALIDATE_URL=https://lazyfounder.in/api/revalidate
AUTO_PUBLISH_ENABLED=false

# --- Security (REQUIRED in production) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=
REVALIDATE_SECRET=
# Generate entries with: npm run auth:hash -- '<password>' <user> <editor|admin>
EDITOR_USERS=

# --- LLM (Bedrock) ---
# This account cannot invoke anthropic.* models; Mistral Large 3 works over the
# Converse API in ap-south-1. Do not switch LLM_MODEL_DEFAULT to a Claude model
# without checking model access first.
BEDROCK_TRANSPORT=converse
BEDROCK_REGION=ap-south-1
AWS_REGION=ap-south-1
LLM_MODEL_DEFAULT=mistral.mistral-large-3-675b-instruct
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
LLM_TIMEOUT_MS=600000
LLM_DAILY_TOKEN_BUDGET=0

# Bedrock credentials. The ECS tasks have no task role, so the SDK has no other
# way to authenticate. Prefer creating a task role and deleting these two.
AWS_BEDROCK_REGION=ap-south-1
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Fetching ---
CRAWLER_USER_AGENT=LazyFoundersBot/1.0 (+https://lazyfounders.com/bot)
FETCH_TIMEOUT_MS=20000
MIN_ARTICLE_CHARS=300
MIN_ARTICLE_CHARS_CJK=120

# --- Raw snapshots ---
# fs writes into the container and is lost on every deploy. Use s3 once a
# bucket exists.
SNAPSHOT_STORAGE=fs
SNAPSHOT_DIR=/app/data/snapshots
# SNAPSHOT_STORAGE=s3
# SNAPSHOT_BUCKET=lazyfounders-raw-snapshots

# --- Dedup ---
DEDUP_WINDOW_DAYS=7
DEDUP_SAME_STORY_COS=0.9
DEDUP_REVIEW_COS=0.8

# --- Media ---
S3_BUCKET_NAME=lazyfounders-blog-images

# --- Alerts ---
ALERT_WEBHOOK_URL=
ALERT_DLQ_THRESHOLD=25
ALERT_SOURCE_FAILURES=3
